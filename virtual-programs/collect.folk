When when the collected matches for /clause/ are /matchesVar/ /body/ with environment /e/ {
    Wish to collect matches for $clause
}

# TODO: Defer recollect for like 4ms right away? Sink other recollects
# into it? Use sysmon to do that?

set cc [C]
$cc cflags -I.
$cc include <string.h>
$cc include "trie.h"
$cc code {
    extern void HoldStatementGlobally(const char *key, double version,
                Jim_Obj *jimClause, long keepMs, const char *destructorCode,
                const char *sourceFileName, int sourceLineNumber);
    extern Jim_Obj* claimizeClause(Jim_Obj* clause);
    extern Jim_Obj* QuerySimple(Jim_Obj* pattern);
    Clause* jimClauseToTrieClause(Jim_Interp* interp, Jim_Obj* obj);

    char* makeCollectKey(Jim_Interp* interp, Jim_Obj* patternObj) {
        const char COLLECT[] = "collect ";
        int collectLen = sizeof(COLLECT) - 1;

        int keyLen = Jim_Length(interp, patternObj);
        char *collectKey = malloc(collectLen + keyLen + 1);
        memcpy(collectKey, COLLECT, collectLen);
        memcpy(collectKey + collectLen, Jim_String(interp, patternObj), keyLen + 1);
        return collectKey;
    }

    int _Atomic version = 0;
}

$cc proc Recollect! {Jim_Obj* patternObj} void {
    // First, query for collect patterns.
    Jim_Obj* collectorTerms[] = {
        Jim_NewStringObjNoInterp("/someone/", -1),
        Jim_NewStringObjNoInterp("wishes", -1),
        Jim_NewStringObjNoInterp("to", -1),
        Jim_NewStringObjNoInterp("collect", -1),
        Jim_NewStringObjNoInterp("matches", -1),
        Jim_NewStringObjNoInterp("for", -1),
        patternObj
    };
    Jim_Obj* collectorClause = Jim_NewListObjNoInterp(
        collectorTerms, sizeof(collectorTerms)/sizeof(collectorTerms[0])
    );

    Jim_Obj* collectorsObj = QuerySimple(collectorClause);
    if (Jim_ListLength(interp, collectorsObj) == 0) {
        Clause* emptyClause = malloc(SIZEOF_CLAUSE(0));
        emptyClause->nTerms = 0;
        HoldStatementGlobally(makeCollectKey(interp, patternObj), version++,
                              Jim_NewEmptyStringObj(interp), 0, NULL, NULL, 0);
    } else {
        Jim_Obj* matchesObj = QuerySimple(patternObj);
        Jim_Obj* claimizedPattern = claimizeClause(patternObj);
        if (claimizedPattern != NULL) {
            Jim_Obj* claimizedMatchesObj = QuerySimple(claimizedPattern);
            Jim_ListAppendList(interp, matchesObj, claimizedMatchesObj);
            Jim_FreeNewObj(claimizedPattern);
        }

        Jim_Obj* collectedTerms[] = {
            Jim_NewStringObjNoInterp("virtual-programs/collect.folk", -1),
            Jim_NewStringObjNoInterp("claims", -1),
            Jim_NewStringObjNoInterp("the", -1),
            Jim_NewStringObjNoInterp("collected", -1),
            Jim_NewStringObjNoInterp("matches", -1),
            Jim_NewStringObjNoInterp("for", -1),
            patternObj,
            Jim_NewStringObjNoInterp("are", -1),
            matchesObj,
        };
        Jim_Obj* collectedClause = Jim_NewListObjNoInterp(
            collectedTerms, sizeof(collectedTerms)/sizeof(collectedTerms[0])
        );

        HoldStatementGlobally(makeCollectKey(interp, patternObj), version++,
                              collectedClause, 0, NULL, NULL, 0);
    }

    Jim_FreeNewObj(collectorsObj);
}
set collectLib [$cc compile]

When /someone/ wishes to collect matches for /pattern/ {
    When {*}$pattern {
        $collectLib Recollect! $pattern
        On unmatch [list $collectLib Recollect! $pattern]
    }
    $collectLib Recollect! $pattern
    On unmatch [list $collectLib Recollect! $pattern]
}
